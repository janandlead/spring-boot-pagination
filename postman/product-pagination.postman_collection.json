{
  "info": {
    "name": "Product pagination scenarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Read-only checks for the existing API. Run against a local application with PostgreSQL available. Populate multiple products and prices for meaningful sorting checks. The Current error behavior folder characterizes unhandled errors (500), not desired validation. See PAGINATION_NOTES.md."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "category",
      "value": "Electronics"
    },
    {
      "key": "missingCategory",
      "value": "__postman_missing_category__"
    },
    {
      "key": "beyondPage",
      "value": "1000000"
    }
  ],
  "item": [
    {
      "name": "Pagination, sorting, category and binding",
      "item": [
        {
          "name": "First page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products?page=0&size=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Page metadata and content\", () => { pm.expect(body.content).to.be.an(\"array\"); pm.expect(body.number).to.eql(0); pm.expect(body.size).to.eql(5); pm.expect(body.numberOfElements).to.eql(body.content.length); pm.expect(body.content.length).to.be.at.most(5); pm.expect(body.totalElements).to.be.at.least(body.content.length); pm.expect(body.totalPages).to.eql(Math.ceil(body.totalElements / 5)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Second page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products?page=1&size=5"
