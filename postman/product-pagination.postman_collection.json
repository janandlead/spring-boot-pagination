        {
          "name": "Beyond last page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products?page={{beyondPage}}&size=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Page metadata and content\", () => { pm.expect(body.content).to.be.an(\"array\"); pm.expect(body.number).to.eql(Number(pm.collectionVariables.get(\"beyondPage\"))); pm.expect(body.size).to.eql(5); pm.expect(body.numberOfElements).to.eql(body.content.length); pm.expect(body.content.length).to.be.at.most(5); pm.expect(body.totalElements).to.be.at.least(body.content.length); pm.expect(body.totalPages).to.eql(Math.ceil(body.totalElements / 5)); });",
                  "pm.test(\"Empty page\", () => pm.expect(body.content).to.eql([]));"
                ]
              }
            }
